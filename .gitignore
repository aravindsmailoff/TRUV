*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Local settings (not project config)
.claude/settings.local.json

# User-specific skills (not part of the template)
.claude/skills/customize/
.claude/skills/release/

# Local temp files
temp/

# Local WhatsApp Linked Device Session & Config
.whatsapp-auth/
.whatsapp-config.json

# Runtime notification/event state written by the app at runtime
.data/

# SQLite temporary files (the database snapshot itself is intentionally tracked)
data/*.sqlite3-journal
data/*.sqlite3-wal
data/*.sqlite3-shm
# Local account credentials and sessions are never part of the Git snapshot
data/local-auth.sqlite3*
